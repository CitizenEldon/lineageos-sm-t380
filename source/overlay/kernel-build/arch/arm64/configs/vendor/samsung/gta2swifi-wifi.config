# Keep core/pronto built in: source uses CONFIG_WCNSS_CORE_PRONTO #ifdef.
# Hold WLAN itself as a module for controlled userspace bring-up.
CONFIG_WLAN=y
CONFIG_CFG80211=y
# Prima unconditionally uses cfg80211 testmode event APIs.
CONFIG_NL80211_TESTMODE=y
CONFIG_WCNSS_CORE=y
CONFIG_WCNSS_CORE_PRONTO=y
CONFIG_PRONTO_WLAN=m
# CONFIG_PRIMA_WLAN is not set
# CONFIG_WCNSS_REGISTER_DUMP_ON_BITE is not set
# CONFIG_QCOM_WCNSS_CTRL is not set
