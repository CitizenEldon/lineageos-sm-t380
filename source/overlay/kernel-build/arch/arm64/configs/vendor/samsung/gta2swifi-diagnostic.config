# Samsung SM-T380 Rev05 no-charge diagnostic image.
CONFIG_LOCALVERSION="-t380-diagnostic"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_ARCH_MSM8917=y
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE_NAMES="samsung-gta2swifi/msm8917-sec-gta2swifi-r05"
CONFIG_OF_IGNORE_QCOM_VENDOR_DTS=y
CONFIG_PINCTRL_MSM8917=y
CONFIG_I2C_GPIO=y
CONFIG_T380_DIAGNOSTIC_POWER=y
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_CPU_THERMAL=y
CONFIG_THERMAL_TSENS=y
CONFIG_THERMAL_QPNP_ADC_TM=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_ACM=y
# Headless diagnostic: DT-disabled WCNSS must not run its built-in initcall.
# The donor WCNSS init dereferences probe-owned penv even without a device.
# CONFIG_WCNSS_CORE is not set
# CONFIG_WCNSS_CORE_PRONTO is not set
# CONFIG_WCNSS_REGISTER_DUMP_ON_BITE is not set
# CONFIG_QCOM_WCNSS_CTRL is not set
# CONFIG_WCNSS_MEM_PRE_ALLOC is not set
# CONFIG_PRONTO_WLAN is not set
# CONFIG_PRIMA_WLAN is not set
# CONFIG_WLAN is not set
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# CONFIG_QPNP_SMBCHARGER is not set
# CONFIG_QPNP_FG is not set
# CONFIG_QPNP_SMB5 is not set
# CONFIG_QPNP_LINEAR_CHARGER is not set
# CONFIG_QPNP_VM_BMS is not set
# CONFIG_QPNP_QG is not set
# CONFIG_MACH_XIAOMI_MSM8937 is not set
# CONFIG_MACH_XIAOMI_RIVA is not set
# CONFIG_MACH_XIAOMI_ROLEX is not set
# CONFIG_MACH_XIAOMI_UGGLITE is not set
# CONFIG_MACH_XIAOMI_UGG is not set
# CONFIG_MACH_XIAOMI_ROVA is not set
# CONFIG_MACH_XIAOMI_ULYSSE is not set
