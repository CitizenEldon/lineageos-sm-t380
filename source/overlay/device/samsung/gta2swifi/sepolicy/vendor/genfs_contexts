# Exact runtime power_supply targets; existing health read rules only.
genfscon sysfs /devices/platform/i2c-fuelgauge/i2c-7/7-0071/power_supply/t380-diag-gauge u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/platform/i2c-charger/i2c-6/6-0049/power_supply/t380-diagnostic-usb u:object_r:sysfs_batteryinfo:s0
# Exact retained PM8937 RTC node; only existing sysfs_rtc read access.
genfscon sysfs /devices/platform/soc/200f000.qcom,spmi/spmi-0/spmi0-00/200f000.qcom,spmi:qcom,pm8937@0:qcom,pm8937_rtc/rtc u:object_r:sysfs_rtc:s0

# One writable GPU-policy actuator for the device Power HAL. This is the
# canonical target behind /sys/class/kgsl/kgsl-3d0 on the pinned T380 kernel.
genfscon sysfs /devices/platform/soc/1c00000.qcom,kgsl-3d0/kgsl/kgsl-3d0/min_pwrlevel u:object_r:t380_sysfs_gpu_min_pwrlevel:s0

# Exact read-only prerequisites. The governor target is the devfreq device
# behind both class symlinks, recorded as 1c00000.qcom,kgsl-3d0 on the tablet.
genfscon sysfs /devices/platform/soc/1c00000.qcom,kgsl-3d0/kgsl/kgsl-3d0/max_pwrlevel u:object_r:t380_sysfs_gpu_policy_status:s0
genfscon sysfs /devices/platform/soc/1c00000.qcom,kgsl-3d0/kgsl/kgsl-3d0/num_pwrlevels u:object_r:t380_sysfs_gpu_policy_status:s0
genfscon sysfs /devices/platform/soc/1c00000.qcom,kgsl-3d0/devfreq/1c00000.qcom,kgsl-3d0/governor u:object_r:t380_sysfs_gpu_policy_status:s0

# Existing backlight driver subtree; reuse the standard Lights HAL access rules.
genfscon sysfs /devices/platform/soc/1a00000.qcom,mdss_mdp/1a00000.qcom,mdss_mdp:qcom,mdss_fb_primary/leds/lcd-backlight u:object_r:sysfs_leds:s0
