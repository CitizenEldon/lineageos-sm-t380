<?xml version="1.0" encoding="UTF-8"?>
<!-- Diagnostic silent primary output. No microphone or real sound device. -->
<audioPolicyConfiguration version="7.0" xmlns:xi="http://www.w3.org/2001/XInclude">
  <globalConfiguration speaker_drc_enabled="false"/>
  <modules>
    <module name="primary" halVersion="2.0">
      <attachedDevices><item>Silent Output</item></attachedDevices>
      <defaultOutputDevice>Silent Output</defaultOutputDevice>
      <mixPorts>
        <mixPort name="silent output" role="source" flags="AUDIO_OUTPUT_FLAG_PRIMARY">
          <profile name="" format="AUDIO_FORMAT_PCM_16_BIT" samplingRates="48000" channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
        </mixPort>
      </mixPorts>
      <devicePorts><devicePort tagName="Silent Output" type="AUDIO_DEVICE_OUT_STUB" role="sink"/></devicePorts>
      <routes><route type="mix" sink="Silent Output" sources="silent output"/></routes>
    </module>
  </modules>
  <xi:include href="audio_policy_volumes.xml"/>
  <xi:include href="default_volume_tables.xml"/>
</audioPolicyConfiguration>
