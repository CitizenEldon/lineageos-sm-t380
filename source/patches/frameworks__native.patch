 EdgeExtensionShaderFactory::EdgeExtensionShaderFactory(RuntimeEffectManager& effectManager) {
     mEffect = effectManager.mKnownEffects[kEdgeExtensionEffect];
+    auto [effect, error] = SkRuntimeEffect::MakeForShader(kEffectSource_LinearEdgeExtensionEffect);
+    LOG_ALWAYS_FATAL_IF(!effect, "Linear edge-extension shader: %s", error.c_str());
+    mLinearEffect = std::move(effect);
+    auto [nearestEffect, nearestError] =
+            SkRuntimeEffect::MakeForShader(kEffectSource_NearestEdgeExtensionEffect);
+    LOG_ALWAYS_FATAL_IF(!nearestEffect, "Nearest edge-extension shader: %s", nearestError.c_str());
+    mNearestEffect = std::move(nearestEffect);
 }
 
