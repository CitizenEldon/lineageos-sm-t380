+        EXPECT_EQ(0u, interiorMismatches);
+        printf("EDGE_INTERIOR variant=%d mismatches=%zu two_level=%zu\n", variant,
+               interiorMismatches, twoLevelDifferences);
+        printf("EDGE_PIXELS variant=%d max_diff=%d mismatches=%zu\n", variant,
+               maxDifference, mismatches);
+    }
