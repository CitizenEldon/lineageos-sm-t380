+const SkString kEffectSource_LinearEdgeExtensionEffect(R"(
+    uniform shader uContentTexture;
+    uniform vec2 uImgSize;
+    uniform vec2 uTextureOrigin;
+
+    // TODO(b/214232209) oobTolerance is temporary and will be removed when the scrollbar will be
+    // hidden during the animation
+    const float oobTolerance = 15;
+    const int blurRadius = 3;
+    const float blurArea = float((2 * blurRadius + 1) * (2 * blurRadius + 1));
+
+    // Seven bilinear samples cover eight texels per axis. Their weights are
+    // [1-f, 1, 1, 1, 1, 1, 1, f]. Pair adjacent weights to reconstruct the
+    // identical box kernel with four bilinear samples per axis (16 total).
+    vec4 boxBlur(vec2 p) {
+        vec2 f = fract(p - uTextureOrigin - vec2(3.5));
+        vec2 w0 = vec2(2) - f;
+        vec2 w3 = vec2(1) + f;
+        vec4 xs = vec4(-3 - f.x + 1 / w0.x, -0.5 - f.x,
+                        1.5 - f.x, 3 - f.x + f.x / w3.x);
+        vec4 ys = vec4(-3 - f.y + 1 / w0.y, -0.5 - f.y,
+                        1.5 - f.y, 3 - f.y + f.y / w3.y);
+        vec4 wx = vec4(w0.x, 2, 2, w3.x);
+        vec4 wy = vec4(w0.y, 2, 2, w3.y);
+        vec4 sumColors = vec4(0);
+        for (int i = 0; i < 4; i++) {
+            for (int j = 0; j < 4; j++) {
+                sumColors += wx[i] * wy[j] * uContentTexture.eval(p + vec2(xs[i], ys[j]));
+            }
+        }
+        return sumColors / 49;
+    }
+
+    vec4 main(vec2 coord) {
+        vec2 nearestTexturePoint = clamp(coord, vec2(0, 0), uImgSize);
+        if (coord == nearestTexturePoint) {
+            return uContentTexture.eval(coord);
+        } else {
+            vec2 samplePoint = nearestTexturePoint + oobTolerance * normalize(
+                                    nearestTexturePoint - coord);
+            return boxBlur(samplePoint);
+        }
+    }
+)");
+
+const SkString kEffectSource_NearestEdgeExtensionEffect(R"(
+    uniform shader uContentTexture;
+    uniform shader uBlurTexture;
+    uniform vec2 uImgSize;
+    uniform vec2 uTextureOrigin;
+    uniform vec2 uContentOffset;
+
+    // TODO(b/214232209) oobTolerance is temporary and will be removed when the scrollbar will be
+    // hidden during the animation
+    const float oobTolerance = 15;
+    const int blurRadius = 3;
+    const float blurArea = float((2 * blurRadius + 1) * (2 * blurRadius + 1));
+
+    // Seven nearest samples select seven whole texels. Snap to their centers,
+    // then combine adjacent pairs with fixed bilinear weights (2, 2, 2, 1).
+    vec4 boxBlur(vec2 p) {
+        vec2 center = floor(p - uTextureOrigin) + vec2(0.5) + uTextureOrigin;
+        vec4 positions = vec4(-2.5, -0.5, 1.5, 3.0);
+        vec4 weights = vec4(2, 2, 2, 1);
+        vec4 sumColors = vec4(0);
+        for (int i = 0; i < 4; i++) {
+            for (int j = 0; j < 4; j++) {
+                sumColors += weights[i] * weights[j] *
+                        uBlurTexture.eval(center + vec2(positions[i], positions[j]));
+            }
+        }
+        return sumColors / 49;
+    }
+
+    vec4 main(vec2 coord) {
+        vec2 nearestTexturePoint = clamp(coord, vec2(0, 0), uImgSize);
+        if (coord == nearestTexturePoint) {
+            return uContentTexture.eval(coord + uContentOffset);
+        } else {
+            vec2 samplePoint = nearestTexturePoint + oobTolerance * normalize(
+                                    nearestTexturePoint - coord);
+            return boxBlur(samplePoint);
+        }
+    }
+)");
