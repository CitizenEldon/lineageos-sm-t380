+    display.clip = Rect(width, height);
+    display.outputDataspace = ui::Dataspace::UNKNOWN;
+    LayerSettings background;
+    background.geometry.boundaries = FloatRect(0, 0, width, height);
+    background.source.solidColor = half3(0.2f, 0.3f, 0.1f);
+    background.sourceDataspace = ui::Dataspace::V0_SRGB;
+    background.alpha = 1.f;
+    const float shifts[] = {50.930927f, 24.053978f, 7.827278f, 0.029305f,
+                            0.f, 0.001f, -0.550964f, -89.346016f};
+    for (int variant = 0; variant < 224; variant++) {
+        SCOPED_TRACE(variant);
+        const bool extended = variant >= 32;
+        // Extra filtered cases keep full alpha so blending cannot hide an edge difference.
+        const bool fullAlphaFiltered = variant >= 160;
+        const int realVariant = fullAlphaFiltered ? (variant - 160) * 2
+                                                 : extended ? variant - 32 : variant;
+        const int edge = extended ? (realVariant / 4) % 4 : 0;
+        const float realShifts[] = {99.7161713f, 50.9309273f, 24.053978f, 7.827278f,
+                                    0.550964f, 0.1743927f, 0.f, 0.0293045f};
+        const float shift = extended ? realShifts[realVariant / 16] : shifts[variant / 4];
+        const float positionX = extended ? (edge == 0 ? shift : edge == 1 ? -shift : 0.f) : shift;
+        const float positionY = extended ? (edge == 2 ? shift : edge == 3 ? -shift : 0.f) : 0.f;
+        LayerSettings layer;
+        // Actual SurfaceFlinger keeps the full animation extension in layer bounds.
+        // Exercise both axes, filtering modes, alpha modes, and subpixel endpoints.
+        layer.geometry.boundaries = extended ? FloatRect(edge == 0 ? -113.f : 0.f,
+                edge == 2 ? -113.f : 0.f, width + (edge == 1 ? 113.f : 0.f),
+                height + (edge == 3 ? 113.f : 0.f))
+                : FloatRect(-shift, 0, width - shift, height);
+        layer.geometry.positionTransform = mat4::translate(vec4(positionX, positionY, 0.f, 1.f));
+        layer.source.buffer.buffer = input;
+        layer.source.buffer.isOpaque = (variant & 1) != 0;
+        layer.source.buffer.usePremultipliedAlpha = true;
+        layer.source.buffer.useTextureFiltering = fullAlphaFiltered || (extended && (variant & 2));
+        // Reproduce LayerFE's production texture transform, including GLConsumer and rounding.
+        float drawing[16];
+        GLConsumer::computeTransformMatrix(drawing, width, height, PIXEL_FORMAT_RGBA_8888,
+                                           Rect(width, height), 0, layer.source.buffer.useTextureFiltering);
+        const Rect win{layer.geometry.boundaries};
+        const mat4 tr = mat4::translate(vec4(.5f, .5f, 0.f, 1.f)) *
+                mat4::scale(vec4(1.f, -1.f, 1.f, 1.f)) *
+                mat4::translate(vec4(-.5f, -.5f, 0.f, 1.f)) *
+                mat4::translate(vec4(float(win.left) / width, float(win.top) / height, 0.f, 1.f)) *
+                mat4::scale(vec4(float(win.width()) / width, float(win.height()) / height, 1.f, 1.f));
+        layer.source.buffer.textureTransform = mat4(static_cast<const float*>(drawing)) * tr;
+        printf("EDGE_LAYERFE variant=%d matrix=[%.9g,%.9g,%.9g,%.9g]\n", variant,
+                layer.source.buffer.textureTransform[0][0], layer.source.buffer.textureTransform[1][1],
+                layer.source.buffer.textureTransform[3][0], layer.source.buffer.textureTransform[3][1]);
+        layer.sourceDataspace = ui::Dataspace::V0_SRGB;
+        layer.alpha = fullAlphaFiltered ? 1.f : (variant & 2) ? 0.55f : 1.f;
+        layer.edgeExtensionEffect = extended ? EdgeExtensionEffect(edge == 0, edge == 1,
+                edge == 2, edge == 3) : EdgeExtensionEffect(shift >= 0, shift < 0, false, false);
+        ASSERT_EQ(0, property_set("debug.renderengine.linear_edge", "0"));
+        invokeDraw(display, {background, layer});
+        const auto expected = readPixels();
+        ASSERT_EQ(0, property_set("debug.renderengine.linear_edge", "1"));
+        invokeDraw(display, {background, layer});
+        const auto actual = readPixels();
+        int maxDifference = 0;
+        size_t mismatches = 0, interiorMismatches = 0;
+        for (size_t i = 0; i < expected.size(); i++) {
+            const int difference = std::abs(int(expected[i]) - int(actual[i]));
+            maxDifference = std::max(maxDifference, difference);
+            const float localX = (i / 4) % width + 0.5f - positionX;
+            const float localY = (i / 4) / width + 0.5f - positionY;
+            if (localX > 1 && localX < width - 1 && localY > 1 && localY < height - 1 &&
+                difference != 0) interiorMismatches++;
+            if (difference > 2) {
+                if (mismatches < 3) printf("EDGE_WINDOW_DIFF variant=%d x=%zu y=%zu c=%zu old=%d new=%d\n",
+                        variant, (i / 4) % width, (i / 4) / width, i % 4, expected[i], actual[i]);
+                mismatches++;
+            }
+        }
+        EXPECT_EQ(0u, mismatches) << "max channel difference " << maxDifference;
+        EXPECT_EQ(0u, interiorMismatches);
+        printf("EDGE_WINDOW variant=%d shift=%.6f max_diff=%d mismatches=%zu interior=%zu\n",
+                variant, shift, maxDifference, mismatches, interiorMismatches);
+    }
+}
