+TEST_P(RenderEngineTest, drawLayers_edgeExtensionLinearPixels) {
+    if (!GetParam()->apiSupported()) GTEST_SKIP();
+    initializeRenderEngine();
+    ScopedLinearEdgeProperty restoreProperty;
+    const auto input = allocateSourceBuffer(96, 224);
+    uint8_t* pixels = nullptr;
+    ASSERT_EQ(NO_ERROR, input->getBuffer()->lock(GRALLOC_USAGE_SW_WRITE_OFTEN,
+                                                reinterpret_cast<void**>(&pixels)));
+    for (int y = 0; y < 224; y++) {
+        for (int x = 0; x < 96; x++) {
+            auto p = pixels + 4 * (y * input->getBuffer()->getStride() + x);
+            p[0] = (x * 11 + y * 3) % 160;
+            p[1] = (x * 5 + y * 13) % 160;
+            p[2] = ((x / 7 + y / 9) % 2) * 150;
+            p[3] = 192; // Valid premultiplied content with nontrivial alpha.
+        }
+    }
+    ASSERT_EQ(NO_ERROR, input->getBuffer()->unlock());
+    const auto readPixels = [&]() {
+        uint8_t* output = nullptr;
+        EXPECT_EQ(NO_ERROR, mBuffer->getBuffer()->lock(GRALLOC_USAGE_SW_READ_OFTEN,
+                                                       reinterpret_cast<void**>(&output)));
+        std::vector<uint8_t> result(DEFAULT_DISPLAY_WIDTH * DEFAULT_DISPLAY_HEIGHT * 4);
+        if (!output) return result;
+        for (int y = 0; y < DEFAULT_DISPLAY_HEIGHT; y++) {
+            std::copy_n(output + y * mBuffer->getBuffer()->getStride() * 4,
+                        DEFAULT_DISPLAY_WIDTH * 4,
+                        result.data() + y * DEFAULT_DISPLAY_WIDTH * 4);
+        }
+        EXPECT_EQ(NO_ERROR, mBuffer->getBuffer()->unlock());
+        return result;
+    };
+    DisplaySettings display;
+    display.physicalDisplay = fullscreenRect();
+    display.clip = fullscreenRect();
+    display.outputDataspace = ui::Dataspace::V0_SRGB;
+    LayerSettings background;
+    background.geometry.boundaries = fullscreenRect().toFloatRect();
+    background.source.solidColor = half3(0.2f, 0.3f, 0.1f);
+    background.sourceDataspace = ui::Dataspace::V0_SRGB;
+    background.alpha = 1.f;
+    for (int variant = 0; variant < 128; variant++) {
+        SCOPED_TRACE(variant);
+        display.outputDataspace = (variant & 32) ? ui::Dataspace::UNKNOWN
+                                                 : ui::Dataspace::V0_SRGB;
+        LayerSettings layer;
+        layer.geometry.boundaries = FloatRect(-16, -16, 112, 240);
+        layer.geometry.positionTransform = mat4::translate(vec4(16.25f, 16.5f, 0.f, 1.f));
+        if (variant & 1) {
+            layer.geometry.positionTransform *= mat4::rotate(0.07f, vec3(0.f, 0.f, 1.f));
+        }
+        layer.source.buffer.buffer = input;
+        layer.source.buffer.usePremultipliedAlpha = true;
+        layer.source.buffer.useTextureFiltering = (variant & 2) != 0;
+        layer.source.buffer.textureTransform = mat4::scale(vec4(128.f / 96.f, 256.f / 224.f, 1.f, 1.f));
+        if (variant & 64) {
+            // A scaled source must retain the original 49-read fallback.
+            layer.source.buffer.textureTransform *= mat4::scale(vec4(0.9f, 0.9f, 1.f, 1.f));
+        }
+        layer.sourceDataspace = ui::Dataspace::V0_SRGB;
+        layer.alpha = (variant & 4) ? 0.55f : 1.f;
+        layer.edgeExtensionEffect = EdgeExtensionEffect(true, true, true, true);
+        if (variant & 8) {
+            layer.geometry.roundedCornersRadii = gui::CornerRadii(13.f);
+            layer.geometry.roundedCornersCrop = layer.geometry.boundaries;
+        }
+        if (variant & 16) {
+            layer.colorTransform = kRemoveGreenAndMoveRedToGreenMat4;
+        }
+        ASSERT_EQ(0, property_set("debug.renderengine.linear_edge", "0"));
+        invokeDraw(display, {background, layer});
+        const auto expected = readPixels();
+        ASSERT_EQ(0, property_set("debug.renderengine.linear_edge", "1"));
+        invokeDraw(display, {background, layer});
+        const auto actual = readPixels();
+        int maxDifference = 0;
+        size_t mismatches = 0;
+        size_t interiorMismatches = 0;
+        size_t twoLevelDifferences = 0;
+        for (size_t i = 0; i < expected.size(); i++) {
+            const int difference = std::abs(int(expected[i]) - int(actual[i]));
+            maxDifference = std::max(maxDifference, difference);
+            const int x = (i / 4) % DEFAULT_DISPLAY_WIDTH;
+            const int y = (i / 4) / DEFAULT_DISPLAY_WIDTH;
+            const float dx = x + 0.5f - 16.25f;
+            const float dy = y + 0.5f - 16.5f;
+            const float angle = (variant & 1) ? 0.07f : 0.f;
+            const float localX = std::cos(angle) * dx + std::sin(angle) * dy;
+            const float localY = -std::sin(angle) * dx + std::cos(angle) * dy;
+            // Stay a pixel clear of the branch boundary and antialias coverage.
+            const bool interior = localX > 1 && localX < 95 && localY > 1 && localY < 223;
+            if (interior && difference != 0) interiorMismatches++;
+            if (difference == 2) {
+                twoLevelDifferences++;
+                if (twoLevelDifferences <= 4) {
+                    printf("EDGE_ROUNDING variant=%d x=%d y=%d channel=%zu local=(%.3f,%.3f) "
+                           "old=%d new=%d interior=%d\n", variant, x, y, i % 4, localX,
+                           localY, expected[i], actual[i], interior);
+                }
+            }
+            // The equivalent kernel is accumulated from quantized bilinear samples.
+            // Allow at most two output levels only in the extended edge region.
+            if (difference > 2) mismatches++;
