 static struct regulator_ops fixed_voltage_ops = {
 };
 
+/* Preserve the inherited direction and level only for the SM-T380 LCD
+ * rails. Normal panel enable/disable remains responsible for cold power order.
+ */
+static int fixed_t380_lcd_gpio_is_enabled(struct gpio_desc *gpio)
+{
+	int ret;
+
+	ret = gpiod_get_direction(gpio);
+	if (ret < 0)
+		return ret;
+	if (ret != 0)
+		return 0;
+
+	ret = gpiod_get_raw_value_cansleep(gpio);
+	if (ret < 0)
+		return ret;
+	return ret == 1;
+}
+
+static int fixed_t380_lcd_is_enabled(struct regulator_dev *rdev)
+{
+	struct fixed_voltage_data *data = rdev_get_drvdata(rdev);
+
+	return fixed_t380_lcd_gpio_is_enabled(data->t380_lcd_gpio);
+}
+
+static int fixed_t380_lcd_enable(struct regulator_dev *rdev)
+{
+	struct fixed_voltage_data *data = rdev_get_drvdata(rdev);
+
+	return gpiod_direction_output_raw(data->t380_lcd_gpio, 1);
+}
+
+static int fixed_t380_lcd_disable(struct regulator_dev *rdev)
+{
+	struct fixed_voltage_data *data = rdev_get_drvdata(rdev);
+
+	return gpiod_direction_output_raw(data->t380_lcd_gpio, 0);
+}
+
+static struct regulator_ops fixed_t380_lcd_ops = {
+	.enable = fixed_t380_lcd_enable,
+	.disable = fixed_t380_lcd_disable,
+	.is_enabled = fixed_t380_lcd_is_enabled,
+};
+
+static int fixed_t380_lcd_request(struct platform_device *pdev,
+				struct fixed_voltage_config *config,
+				struct fixed_voltage_data *data)
+{
+	enum of_gpio_flags flags;
+	int gpio, ret;
+
+	gpio = of_get_named_gpio_flags(pdev->dev.of_node, "gpio", 0, &flags);
+	if (gpio < 0)
+		return gpio;
+	if (!gpio_is_valid(gpio) || gpio != config->gpio || flags ||
+	    !config->enable_high || config->gpio_is_open_drain ||
+	    config->enabled_at_boot || config->init_data->constraints.boot_on ||
+	    config->init_data->constraints.always_on) {
+		dev_err(&pdev->dev,
+			"T380 LCD rail requires active-high push-pull without boot/always-on\n");
+		return -EINVAL;
+	}
+
+	/* Request without gpio_request_one(): no direction or level write.
+	 * GPIO devres precedes regulator devres, so unregister runs first.
+	 */
+	ret = devm_gpio_request(&pdev->dev, gpio, config->supply_name);
+	if (ret)
+		return ret;
+	data->t380_lcd_gpio = gpio_to_desc(gpio);
+	if (!data->t380_lcd_gpio)
+		return -EINVAL;
+
+	ret = fixed_t380_lcd_gpio_is_enabled(data->t380_lcd_gpio);
+	return ret < 0 ? ret : 0;
+}
