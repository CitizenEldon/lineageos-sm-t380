index 2bdb8bc4c..e72f76fc9 100644
--- a/drivers/i2c/i2c-core-base.c
+++ b/drivers/i2c/i2c-core-base.c
@@ -29,6 +29,8 @@
 #include <linux/errno.h>
 #include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
+#include <linux/t380_gauge_trace.h>
+#include <linux/rcupdate.h>
 #include <linux/i2c-smbus.h>
 #include <linux/idr.h>
 #include <linux/init.h>
@@ -1874,10 +1876,72 @@ static int i2c_check_for_quirks(struct i2c_adapter *adap, struct i2c_msg *msgs,
  * Adapter lock must be held when calling this function. No debug logging
  * takes place.
  */
+/* One explicitly bound gauge observer; no adapter-global address guess. */
+static DEFINE_MUTEX(t380_gauge_observer_lock);
+static struct t380_gauge_trace_observer __rcu *t380_gauge_observer;
+static u64 t380_gauge_registration;
+int t380_gauge_trace_register(struct t380_gauge_trace_observer *o)
+{
+ int ret = 0;
+ if (!o || !o->adapter || !o->begin || !o->end || o->address > 0x7f)
+  return -EINVAL;
+ mutex_lock(&t380_gauge_observer_lock);
+ if (rcu_access_pointer(t380_gauge_observer)) ret = -EBUSY;
+ else if (t380_gauge_registration == ~(u64)0) ret = -EOVERFLOW;
+ else {
+  o->registration = ++t380_gauge_registration;
+  rcu_assign_pointer(t380_gauge_observer, o);
+ }
+ mutex_unlock(&t380_gauge_observer_lock);
+ return ret;
+}
+EXPORT_SYMBOL_GPL(t380_gauge_trace_register);
+void t380_gauge_trace_unregister(struct t380_gauge_trace_observer *o)
+{
+ mutex_lock(&t380_gauge_observer_lock);
+ if (rcu_access_pointer(t380_gauge_observer) == o) {
+  RCU_INIT_POINTER(t380_gauge_observer, NULL);
+  synchronize_rcu();
+ }
+ mutex_unlock(&t380_gauge_observer_lock);
+}
+EXPORT_SYMBOL_GPL(t380_gauge_trace_unregister);
+struct t380_core_trace_token { u64 registration, record; };
+static struct t380_core_trace_token t380_core_trace_begin(
+ struct i2c_adapter *adap, struct i2c_msg *msgs, int num, int attempt)
+{
+ struct t380_core_trace_token token = {0, 0};
+ struct t380_gauge_trace_observer *o;
+ int i;
+ rcu_read_lock();
+ o = rcu_dereference(t380_gauge_observer);
+ if (o && o->adapter == adap) {
+  for (i = 0; i < num; ++i) if (msgs[i].addr == o->address) {
+   token.registration = o->registration;
+   token.record = o->begin(o->context, msgs, num, attempt);
+   break;
+  }
+ }
+ rcu_read_unlock();
+ return token;
+}
+static void t380_core_trace_end(struct t380_core_trace_token token,
+ struct i2c_adapter *adap, struct i2c_msg *msgs, int num, int ret)
+{
+ struct t380_gauge_trace_observer *o;
+ if (!token.record) return;
+ rcu_read_lock();
+ o = rcu_dereference(t380_gauge_observer);
+ if (o && o->adapter == adap && o->registration == token.registration)
+  o->end(o->context, token.record, msgs, num, ret);
+ rcu_read_unlock();
+}
+
