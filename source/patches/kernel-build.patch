+	 * notify_current_mA can remain stale after other state transitions.
+	 * Do not dereference a concurrently detached gadget or use cur_power:
+	 * the inhibited notification path deliberately does not update it. */
+	requested_ma = READ_ONCE(motg->notify_current_mA);
+	inputs = READ_ONCE(motg->inputs);
+	chg_type = READ_ONCE(motg->chg_type);
+	chg_state = READ_ONCE(motg->chg_state);
