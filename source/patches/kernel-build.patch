 {
 	unsigned long orig_jiffies;
 	int ret, try;
+ struct t380_core_trace_token gauge_trace;
 
 	if (!adap->algo->master_xfer) {
 		dev_dbg(&adap->dev, "I2C level transfers not supported\n");
@@ -1907,7 +1971,9 @@ int __i2c_transfer(struct i2c_adapter *adap, struct i2c_msg *msgs, int num)
 	/* Retry automatically on arbitration loss */
 	orig_jiffies = jiffies;
 	for (ret = 0, try = 0; try <= adap->retries; try++) {
+		gauge_trace = t380_core_trace_begin(adap, msgs, num, try);
 		ret = adap->algo->master_xfer(adap, msgs, num);
+		t380_core_trace_end(gauge_trace, adap, msgs, num, ret);
 		if (ret != -EAGAIN)
 			break;
 		if (time_after(jiffies, orig_jiffies + adap->timeout))
